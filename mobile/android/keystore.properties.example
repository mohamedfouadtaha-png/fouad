# انسخ الملف ده باسم keystore.properties (في نفس الفولدر) وحط بياناتك.
# keystore.properties و ملف .jks مش بيترفعوا على GitHub. احتفظ بنسخة احتياطية منهم في مكان آمن:
# لو ضاعوا مش هتقدر تحدّث التطبيق على Google Play بنفس المفتاح.
storeFile=/Users/YOUR_NAME/keys/seerah-upload.jks
storePassword=CHANGE_ME
keyAlias=seerah-upload
keyPassword=CHANGE_ME
